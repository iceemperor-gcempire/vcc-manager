FROM node:22-alpine

WORKDIR /app

# 동영상 썸네일(첫 프레임) 추출용 ffmpeg (#672). CLI 로만 호출(앱 코드에 링크하지 않음)
RUN apk add --no-cache ffmpeg

# pnpm 활성화 (v11+ — minimumReleaseAge 1440 기본값으로 신규 release 24h cooldown)
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml ./
# --frozen-lockfile: lockfile 무결성 / --prod: dev 제외.
# pnpm 11 기본 strict-dep-builds 비활성화 — 침해 방지 효과 (모든 script 차단) 는 유지하되,
# 정상 dep 의 ignore 가 빌드 실패 (ERR_PNPM_IGNORED_BUILDS) 로 처리되지 않게 함.
# sharp v0.34 / msgpackr-extract 등은 binary 가 regular deps 로 들어와 script 없이 동작.
RUN pnpm config set strict-dep-builds false && pnpm install --frozen-lockfile --prod

COPY src/ ./src/
COPY docs/updatelogs/ ./docs/updatelogs/

# 오픈소스 라이선스 고지 (#1063) — 이미지의 /app/THIRD_PARTY_LICENSES.txt
COPY scripts/third-party-notices.cjs scripts/third-party-license-review.json ./scripts/
RUN node scripts/third-party-notices.cjs notice --out THIRD_PARTY_LICENSES.txt --title "VCC Manager 백엔드" \
    --system "ffmpeg (Alpine 패키지, 동영상 썸네일 추출에 CLI 로만 호출) — LGPL-2.1-or-later / GPL-2.0-or-later, https://ffmpeg.org/legal.html"

RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodeuser -u 1001

RUN mkdir -p uploads/reference uploads/generated uploads/backup-temp uploads/restore-temp backups
RUN chown -R nodeuser:nodejs uploads backups

USER nodeuser

EXPOSE 3000

CMD ["node", "src/server.js"]
