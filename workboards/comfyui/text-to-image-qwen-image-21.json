    "workflowData": "{\"1\":{\"inputs\":{\"unet_name\":\"{{##base_model##}}\",\"weight_dtype\":\"default\"},\"class_type\":\"UNETLoader\",\"_meta\":{\"title\":\"Qwen-Image 2.1 모델\"}},\"2\":{\"inputs\":{\"clip_name\":\"qwen3vl_8b_int8_convrot.safetensors\",\"type\":\"qwen_image\",\"device\":\"default\"},\"class_type\":\"CLIPLoader\",\"_meta\":{\"title\":\"Qwen3-VL 텍스트 인코더\"}},\"3\":{\"inputs\":{\"vae_name\":\"qwen_image_2.1_vae_bf16.safetensors\"},\"class_type\":\"VAELoader\",\"_meta\":{\"title\":\"Qwen-Image 2.1 VAE\"}},\"4\":{\"inputs\":{\"clip\":[\"2\",0],\"prompt\":\"{{##prompt##}}\",\"negative_prompt\":\"{{##negative_prompt##}}\",\"resolution\":1024},\"class_type\":\"TextEncodeQwenImage21\",\"_meta\":{\"title\":\"프롬프트 인코딩 (긍정·부정)\"}},\"5\":{\"inputs\":{\"width\":\"{{##width##}}\",\"height\":\"{{##height##}}\",\"batch_size\":1},\"class_type\":\"EmptyLatentImage\",\"_meta\":{\"title\":\"빈 latent\"}},\"6\":{\"inputs\":{\"noise\":[\"35\",0],\"guider\":[\"36\",0],\"sampler\":[\"34\",0],\"sigmas\":[\"33\",0],\"latent_image\":[\"5\",0]},\"class_type\":\"SamplerCustomAdvanced\",\"_meta\":{\"title\":\"SamplerCustomAdvanced\"}},\"7\":{\"inputs\":{\"samples\":[\"6\",0],\"vae\":[\"3\",0]},\"class_type\":\"VAEDecode\",\"_meta\":{\"title\":\"디코드\"}},\"8\":{\"inputs\":{\"model_name\":\"{{##upscale_model##}}\"},\"class_type\":\"UpscaleModelLoader\",\"_meta\":{\"title\":\"업스케일 모델\"}},\"9\":{\"inputs\":{\"upscale_model\":[\"8\",0],\"image\":[\"7\",0]},\"class_type\":\"ImageUpscaleWithModel\",\"_meta\":{\"title\":\"업스케일 (선택)\"},\"_vcc\":{\"bypassUnless\":{\"condition\":\"{{##upscale_model##}}\",\"passthrough\":{\"0\":\"image\"}}}},\"10\":{\"inputs\":{\"filename_prefix\":\"{{##user_id##}}\\\\image\\\\qwen_image_21\",\"images\":[\"9\",0]},\"class_type\":\"SaveImage\",\"_meta\":{\"title\":\"이미지 저장\"}},\"30\":{\"inputs\":{\"model\":[\"1\",0],\"scheduler\":\"simple\",\"steps\":\"{{##steps##}}\",\"denoise\":1},\"class_type\":\"BasicScheduler\",\"_meta\":{\"title\":\"일반 일정 (simple)\"}},\