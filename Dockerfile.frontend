FROM node:22-alpine AS builder

WORKDIR /app/frontend

# pnpm 활성화 (v11+ — minimumReleaseAge 1440 기본값으로 신규 release 24h cooldown)
RUN corepack enable && corepack prepare pnpm@latest --activate

# pnpm-workspace.yaml: allowBuilds 로 esbuild build script 명시적 거부 (#687)
# — pnpm 11.5+ 에서 strict-dep-builds config 만으로는 ERR_PNPM_IGNORED_BUILDS 가 해소되지 않음
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
# --frozen-lockfile: lockfile 무결성.
# strict-dep-builds=false 로 ERR_PNPM_IGNORED_BUILDS 회피 (script 차단 자체는 유지 — 침해 방지).
RUN pnpm config set strict-dep-builds false && pnpm install --frozen-lockfile

COPY frontend/ ./

# Build arguments for environment variables (Vite — #526)
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN pnpm run build

FROM nginx:alpine

COPY --from=builder /app/frontend/build /usr/share/nginx/html

# nginx 공식 이미지의 템플릿 기능 (#815) — /etc/nginx/templates/*.template 을 기동 시
# envsubst 로 치환해 /etc/nginx/conf.d/ 에 쓴다. client_max_body_size 를 환경변수로 받기 위함.
#
# NGINX_ENVSUBST_FILTER 로 치환 대상을 NGINX_ 접두 변수로 한정한다. 걸지 않으면 envsubst 가
# 환경에 같은 이름이 있을 때 $uri · $host · $remote_addr 같은 **nginx 변수까지 치환**해
# 설정이 조용히 망가진다.
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
ENV NGINX_ENVSUBST_FILTER="^NGINX_"
ENV NGINX_MAX_BODY_SIZE=150M

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
